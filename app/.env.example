# Copy to app/.env.local (git-ignored). On Vercel, add the same names as environment variables.
#
# TWO KINDS OF VARIABLES:
#   NEXT_PUBLIC_*  are shipped to every visitor's browser. Public values ONLY (addresses, URLs, a bot USERNAME).
#                  NEVER put a token, key or secret in a NEXT_PUBLIC_ variable.
#   everything else is server-side. Mark the secrets "Sensitive" on Vercel.

# ───────────────────────── public (browser) ─────────────────────────
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=https://bsc-testnet-rpc.publicnode.com,https://data-seed-prebsc-1-s1.bnbchain.org:8545,https://data-seed-prebsc-2-s1.bnbchain.org:8545
NEXT_PUBLIC_WARUNG_ADDRESS=0x
NEXT_PUBLIC_IDRX_ADDRESS=0x
NEXT_PUBLIC_REPUTATION_ADAPTER=0x
NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
NEXT_PUBLIC_AGENT_ID=2535
NEXT_PUBLIC_DEMO_MERCHANT=0x          # demo shop shown on the landing page
NEXT_PUBLIC_TELEGRAM_BOT=KulayaBot    # bot USERNAME without @ (not the token!)
NEXT_PUBLIC_SITE_URL=https://kulaya.vercel.app   # used for social-preview metadata
NEXT_PUBLIC_WC_PROJECT_ID=            # free id from https://cloud.reown.com ; enables the wallet picker for phones without a wallet browser

# ───────────────────────── server only ─────────────────────────
# Chain / contracts
RPC_URL=https://bsc-testnet-rpc.publicnode.com,https://data-seed-prebsc-1-s1.bnbchain.org:8545,https://data-seed-prebsc-2-s1.bnbchain.org:8545
LOGS_RPC_URL=https://bnb-testnet.api.onfinality.io/public,https://bsc-testnet-rpc.publicnode.com   # nodes that keep historical logs
CHAIN_ID=97
WARUNG_ADDRESS=0x
IDRX_ADDRESS=0x
REPUTATION_ADAPTER=0x
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
AGENT_ID=2535
DEPLOY_BLOCK=0                        # block of the Warung deployment (log scans start here)
REDTEAM_MERCHANT=0x                   # shop the /protocol/redteam sandbox reads
REDTEAM_RATE_LIMIT=20                 # model attacks per IP per hour
APP_URL=https://kulaya.vercel.app     # used in QR payment links, loan links and Telegram login links

# Keys (SECRET)
UNDERWRITER_PRIVATE_KEY=0x            # the AI's key: can only call proposeLoan, holds no funds
RELAYER_PRIVATE_KEY=0x                # pays users' gas; holds only gas money
SESSION_SECRET=                       # 32+ random chars (openssl rand -hex 32): signs dashboard sign-in tokens
TELEGRAM_BOT_TOKEN=                   # from @BotFather
TELEGRAM_WEBHOOK_SECRET=              # 16+ random chars (openssl rand -hex 24)

# LLM providers (SECRET): set at least one. Order of preference: Groq > Cerebras > Mistral > OpenRouter > Gemini (override with LLM_CHAIN).
GROQ_API_KEY=                         # https://console.groq.com/keys (free, no card; also gives free Whisper voice transcription)
CEREBRAS_API_KEY=                     # https://cloud.cerebras.ai (free)
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey
# LLM_CHAIN=groq:openai/gpt-oss-120b,cerebras:gpt-oss-120b,gemini:gemini-3.5-flash

# Redis (injected by the Vercel Upstash integration; needed locally for `npm run warm` and the live scripts)
KV_REST_API_URL=
KV_REST_API_TOKEN=
