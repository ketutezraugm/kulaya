# Copy to app/.env.local (gitignored). Everything here is public; never put a private key in this file.

NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=https://bsc-testnet-rpc.publicnode.com,https://data-seed-prebsc-1-s1.bnbchain.org:8545,https://data-seed-prebsc-2-s1.bnbchain.org:8545

# Filled in after deploy
NEXT_PUBLIC_WARUNG_ADDRESS=0x
NEXT_PUBLIC_IDRX_ADDRESS=0x

NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
NEXT_PUBLIC_AGENT_ID=

# MegaFuel gasless endpoint (BSC testnet). Sponsor policy is created in the NodeReal dashboard.
NEXT_PUBLIC_MEGAFUEL_URL=https://bsc-megafuel-testnet.nodereal.io/

# Bot's /redteam API
NEXT_PUBLIC_BOT_API_URL=http://localhost:8787

# demo shop shown on the landing page
NEXT_PUBLIC_DEMO_MERCHANT=0x
