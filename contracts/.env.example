# Copy to contracts/.env (gitignored). TESTNET ONLY: use a throwaway wallet, never a real one.

# Deployer wallet = admin + guardian. Fund with tBNB: https://www.bnbchain.org/en/testnet-faucet
PRIVATE_KEY=0x

# Address (not key) of the AI underwriter. It can only propose loans and holds no funds.
# Generate one: cast wallet new
AGENT_ADDRESS=0x

# Revenue bucket length in seconds. 600 = 10 min (demo, lets you seed history in an hour). 86400 = 1 day (production).
EPOCH_SECONDS=600

# Optional: for `forge script ... --verify`. Get a key at https://etherscan.io/myapikey (works for BscScan v2)
ETHERSCAN_API_KEY=
