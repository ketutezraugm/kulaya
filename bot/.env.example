# Copy to bot/.env (gitignored).

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Telegram: create a bot with @BotFather and paste the token
TELEGRAM_BOT_TOKEN=

# Chain: BSC testnet (chainId 97). Use publicnode: the official data-seed RPCs reject eth_getLogs.
RPC_URL=https://bsc-testnet-rpc.publicnode.com,https://data-seed-prebsc-1-s1.bnbchain.org:8545,https://data-seed-prebsc-2-s1.bnbchain.org:8545
CHAIN_ID=97

# Private key of AGENT_ADDRESS from contracts/.env. It can only call proposeLoan(); keep it funded with a little tBNB.
UNDERWRITER_PRIVATE_KEY=0x

# Filled in after `forge script script/Deploy.s.sol --broadcast`
WARUNG_ADDRESS=0x
IDRX_ADDRESS=0x

# ERC-8004 on BSC testnet (verified on-chain, v2.0.0)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Set after registering the agent
AGENT_ID=

# Public URL of the web app (used in payment QR codes and loan-accept links)
APP_URL=http://localhost:3000

# /redteam API: max attack attempts per IP per hour (protects the Gemini free quota)
REDTEAM_RATE_LIMIT=20

# block of the Warung deployment (log scans start here)
DEPLOY_BLOCK=0

# gasless relayer: pays gas for users signed actions. Separate from the AI key; holds only gas money.
RELAYER_PRIVATE_KEY=0x
